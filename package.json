{
  "name": "evm-userop-relay",
  "version": "1.0.0",
  "description": "Node.js API that submits POST body as calldata in an ERC-4337 UserOperation via Alchemy Gas Manager",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "compile": "hardhat compile",
    "typechain": "typechain --target ethers-v6 --out-dir types \"artifacts/**/*.json\"",
    "build": "npm run compile && npm run typechain",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:verify": "hardhat run scripts/deploy-and-verify.js",
    "verify": "hardhat verify"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-verify": "^3.0.17",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "hardhat": "^3.4.5",
    "typechain": "^8.2.0",
    "@typechain/ethers-v6": "^0.6.0"
  },
  "dependencies": {
    "@account-kit/infra": "^4.88.2",
    "@account-kit/smart-contracts": "^4.88.2",
    "@alchemy/aa-accounts": "^3.19.0",
    "@alchemy/aa-alchemy": "^3.19.0",
    "@alchemy/aa-core": "^3.19.0",
    "alchemy-sdk": "^3.6.5",
    "express": "^5.2.1",
    "viem": "^2.48.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jota-ele-ene/evm-userop-relay.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jota-ele-ene/evm-userop-relay/issues"
  },
  "homepage": "https://github.com/jota-ele-ene/evm-userop-relay#readme"
}
