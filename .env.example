# ─── Alchemy ──────────────────────────────────────────────────────────────────
# Get your API key at https://dashboard.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Gas Manager Policy ID – create one at:
# https://dashboard.alchemy.com/gas-manager
ALCHEMY_GAS_POLICY_ID=your_policy_id_here

# ─── Smart Account Owner ──────────────────────────────────────────────────────
# Private key of the EOA that owns the smart account (no 0x prefix needed)
OWNER_PRIVATE_KEY=your_private_key_here

# ─── Target Contract ─────────────────────────────────────────────────────────
# Address of the contract you want to call with the POST body as calldata
TARGET_CONTRACT_ADDRESS=0xYourTargetContractAddress

# ─── Network selection ───────────────────────────────────────────────────────
# Supported networks are provided by @account-kit/infra.
# The frontend selects the active network for the relay operation.

# ─── Sepolia ─────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
EXPLORER_BASE_URL=https://sepolia.etherscan.io/inputdatadecoder?tx=
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_here

# ─── Polygon ─────────────────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
POLYGON_EXPLORER_BASE_URL=https://polygonscan.com/tx/
POLYGON_PRIVATE_KEY=your_polygon_private_key_here

# ─── Base ───────────────────────────────────────────────────────────────────
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
BASE_EXPLORER_BASE_URL=https://basescan.org/tx/
BASE_PRIVATE_KEY=your_base_private_key_here

# ─── Optimism ─────────────────────────────────────────────────────────────────
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
OPTIMISM_EXPLORER_BASE_URL=https://optimistic.etherscan.io/tx/
OPTIMISM_PRIVATE_KEY=your_optimism_private_key_here

# ─── Arbitrum ─────────────────────────────────────────────────────────────────
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
ARBITRUM_EXPLORER_BASE_URL=https://arbiscan.io/tx/
ARBITRUM_PRIVATE_KEY=your_arbitrum_private_key_here

# ─── Amoy ───────────────────────────────────────────────────────────────────
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_alchemy_api_key_here
AMOY_EXPLORER_BASE_URL=https://sepolia.etherscan.io/inputdatadecoder?tx=
AMOY_PRIVATE_KEY=your_amoy_private_key_here

# ─── Etherscan / Scan API Key ─────────────────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
